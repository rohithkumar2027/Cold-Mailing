# Google Sheets Configuration (optional - the CLI can sync to a Google Sheet)
GOOGLE_SHEET_NAME=Recruiter_Leads_Internships
GOOGLE_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Email lookup keys (all optional). Without keys the app still finds emails
# that recruiters have PUBLISHED online; with keys it also asks ContactOut/Apollo.
#
# You can list SEVERAL keys separated by commas. Keys are used in order: when one
# runs out of credits, is invalid, or is rate-limited, the next key is used
# automatically. Never commit your real .env file.
# ---------------------------------------------------------------------------
CONTACTOUT_API_KEYS=
# e.g. CONTACTOUT_API_KEYS=key_one,key_two,key_three

APOLLO_API_KEYS=

# Single-key names still work too
CONTACTOUT_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
